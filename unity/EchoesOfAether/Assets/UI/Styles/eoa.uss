/* Echoes of Aether - UI design system (UI Toolkit port of src/ui/styles.css).
   Dark graphite, precise lines, restrained cyan/violet accents.
   Reference resolution 1920x1080; base font 18px (the prototype's 15px at 1600 px wide).
   USS has no grid, gradients, box-shadow or text-transform: layouts use flexbox, gradients are baked
   textures in ../Textures tinted with -unity-background-image-tint-color, upper-casing happens in code.
   Fonts are assigned in eoa_fonts.uss. */

.eoa-root {
    --bg-1: rgba(8, 7, 16, 0.92);
    --bg-2: rgba(14, 11, 26, 0.88);
    --bg-3: rgba(24, 18, 40, 0.9);
    --line: rgba(0, 229, 255, 0.2);
    --line-2: rgba(255, 43, 214, 0.38);
    --text: #dfe7ee;
    --text-dim: #8a9aab;
    --text-faint: #5b6876;
    --cyan: #00e5ff;
    --cyan-dim: rgba(0, 229, 255, 0.35);
    --violet: #ff2bd6;
    --violet-dim: rgba(255, 43, 214, 0.35);
    --amber: #ffe14d;
    --red: #ff5a4a;
    --green: #73e6b0;
    font-size: 18px;
    color: var(--text);
}

.layer, .screen, .fader, .dialogue-root, .hud, .center-wrap, .dim-vignette, .death-vignette {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.flex-spacer { flex-grow: 1; }
.spacer-s { height: 14px; }

/* ---------------------------------------------------------------- Shared primitives */
.panel {
    background-color: rgba(13, 18, 25, 0.93);
    border-width: 1px;
    border-color: var(--line);
}
.corner-tl {
    position: absolute;
    left: -1px;
    top: -1px;
    width: 22px;
    height: 22px;
    border-left-width: 2px;
    border-top-width: 2px;
    border-color: var(--cyan);
}
.corner-br {
    position: absolute;
    right: -1px;
    bottom: -1px;
    width: 22px;
    height: 22px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-color: var(--violet);
}
.kicker { font-size: 13px; letter-spacing: 4px; color: var(--cyan); }
.h1 { font-size: 43px; letter-spacing: 2.6px; }
.h2 { font-size: 27px; letter-spacing: 2.2px; }
.dim { color: var(--text-dim); }
.faint { color: var(--text-faint); }
.icon { width: 43px; height: 43px; flex-shrink: 0; }

.btn {
    flex-direction: row;
    align-items: center;
    margin: 0;
    padding: 13px 20px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px 1px 1px 2px;
    border-color: rgba(0, 0, 0, 0);
    color: var(--text-dim);
    font-size: 19px;
    letter-spacing: 3.4px;
    -unity-text-align: middle-left;
    transition-property: color, padding-left, border-left-color;
    transition-duration: 0.12s;
}
.btn:hover, .btn.focus {
    color: var(--text);
    background-image: url("../Textures/grad_h.png");
    -unity-background-image-tint-color: rgba(95, 212, 240, 0.14);
    border-left-color: var(--cyan);
    padding-left: 25px;
}
.btn:disabled { color: var(--text-faint); }
.btn-main { flex-grow: 1; flex-shrink: 1; }
.btn-sub {
    margin-left: 16px;
    flex-shrink: 0;
    font-size: 14px;
    letter-spacing: 0.6px;
    color: var(--text-faint);
    -unity-text-align: middle-right;
}

.btn-small {
    margin: 0;
    padding: 8px 16px;
    flex-shrink: 0;
    background-color: var(--bg-3);
    border-width: 1px;
    border-color: var(--line-2);
    color: var(--text);
    font-size: 15px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    white-space: nowrap;
}
.btn-small:hover, .btn-small.focus { border-color: var(--cyan); color: #ffffff; background-color: rgba(95, 212, 240, 0.12); }
.btn-small.primary { border-color: var(--cyan); background-color: rgba(95, 212, 240, 0.16); }
.btn-small.primary.focus, .btn-small.primary:hover { background-color: rgba(95, 212, 240, 0.28); }
.btn-small.danger { border-color: rgba(255, 90, 74, 0.6); }
.btn-small.danger:hover, .btn-small.danger.focus { background-color: rgba(255, 90, 74, 0.16); border-color: var(--red); }
.btn-small:disabled { opacity: 0.4; }

.keycap {
    min-width: 22px;
    height: 22px;
    margin: 0 2px;
    padding: 0 6px;
    flex-shrink: 0;
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: 2px;
    background-color: rgba(0, 0, 0, 0.45);
    font-size: 13px;
    letter-spacing: 0.6px;
    color: var(--text);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.keytext { flex-direction: row; flex-wrap: wrap; align-items: center; }
.keytext.center { justify-content: center; }
.kt-w.sp { margin-right: 5px; }

.section-title { font-size: 13.5px; letter-spacing: 4px; color: var(--cyan); margin: 25px 0 9px 14px; }

.dim-bg { background-color: rgba(5, 8, 12, 0.6); }
.dim-vignette { background-image: url("../Textures/vignette.png"); -unity-background-image-tint-color: rgba(3, 5, 8, 0.85); }
.center-wrap { align-items: center; justify-content: center; }

/* ---------------------------------------------------------------- Scroll views (no default theme is imported) */
.unity-scroll-view { flex-shrink: 1; }
.unity-scroll-view__content-and-vertical-scroll-container { flex-direction: row; flex-grow: 1; flex-shrink: 1; }
.unity-scroll-view__content-viewport { flex-grow: 1; flex-shrink: 1; overflow: hidden; }
.unity-scroll-view__content-container { flex-grow: 0; flex-shrink: 0; }
.unity-scroll-view__horizontal-scroller { display: none; }
.unity-scroller--vertical { width: 6px; flex-shrink: 0; margin-left: 6px; }
.unity-scroller__low-button, .unity-scroller__high-button, .unity-scroller .unity-base-field__label, .unity-scroller .unity-base-slider__dragger-border { display: none; }
.unity-scroller__slider, .unity-scroller .unity-base-slider__input, .unity-scroller .unity-base-slider__drag-container { flex-grow: 1; margin: 0; padding: 0; }
.unity-scroller .unity-base-slider__tracker { position: absolute; left: 1px; right: 1px; top: 0; bottom: 0; background-color: rgba(255, 255, 255, 0.04); }
.unity-scroller .unity-base-slider__dragger { position: absolute; left: 0; width: 6px; min-height: 24px; border-radius: 3px; background-color: rgba(130, 190, 220, 0.35); }
.unity-scroller .unity-base-slider__dragger:hover { background-color: rgba(130, 190, 220, 0.6); }

/* ---------------------------------------------------------------- Controls */
.slider { flex-direction: row; align-items: center; flex-grow: 1; }
.slider-track { flex-grow: 1; height: 18px; }
.slider-rail { position: absolute; left: 0; right: 0; top: 7px; height: 4px; border-radius: 2px; background-color: rgba(255, 255, 255, 0.12); }
.slider-fill { position: absolute; left: 0; top: 7px; height: 4px; border-radius: 2px; background-color: var(--cyan); }
.slider-knob {
    position: absolute;
    top: 2px;
    width: 14px;
    height: 14px;
    margin-left: -7px;
    border-radius: 7px;
    border-width: 2px;
    border-color: #0b1016;
    background-color: var(--cyan);
}
.slider:hover .slider-knob, .slider.focus .slider-knob { background-color: #ffffff; border-color: var(--cyan); }
.slider-val { width: 54px; margin-left: 14px; flex-shrink: 0; font-size: 14px; color: var(--text-dim); -unity-text-align: middle-right; }

.seg { flex-direction: row; flex-wrap: wrap; justify-content: flex-end; flex-grow: 1; }
.seg-btn {
    flex-grow: 1;
    min-width: 57px;
    margin: 0 0 0 4px;
    padding: 8px 9px;
    background-color: rgba(0, 0, 0, 0.3);
    border-width: 1px;
    border-color: var(--line);
    color: var(--text-dim);
    font-size: 13px;
    letter-spacing: 1.3px;
    -unity-text-align: middle-center;
    white-space: nowrap;
}
.seg-btn:hover { color: var(--text); border-color: var(--line-2); }
.seg-btn.sel { border-color: var(--cyan); color: var(--text); background-color: rgba(95, 212, 240, 0.14); }
.seg.focus .seg-btn { border-color: var(--line-2); }
.seg.focus .seg-btn.sel { border-color: #9fe6f7; background-color: rgba(95, 212, 240, 0.24); }
.seg-left { justify-content: flex-start; flex-grow: 0; margin-bottom: 18px; }
.seg-left > .seg-btn { flex-grow: 0; margin: 0 4px 0 0; padding: 8px 16px; }

.toggle {
    width: 54px;
    height: 27px;
    margin: 0;
    padding: 0;
    flex-shrink: 0;
    align-self: flex-end;
    border-width: 1px;
    border-color: var(--line-2);
    background-color: rgba(0, 0, 0, 0.4);
}
.toggle-knob {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 18px;
    height: 18px;
    background-color: var(--text-faint);
    transition-property: left, background-color;
    transition-duration: 0.15s;
}
.toggle.on { border-color: var(--cyan); background-color: rgba(95, 212, 240, 0.2); }
.toggle.on .toggle-knob { left: 30px; background-color: var(--cyan); }
.toggle:hover, .toggle.focus { border-color: #9fe6f7; }
.toggle.focus .toggle-knob { background-color: #ffffff; }

.swatches { flex-direction: row; flex-wrap: wrap; align-items: center; padding: 3px; }
.swatches.focus { background-color: rgba(95, 212, 240, 0.08); }
.sw { width: 31px; height: 31px; margin: 0 6px 6px 0; padding: 0; border-width: 1px; border-color: rgba(255, 255, 255, 0.18); }
.sw:hover { border-color: rgba(255, 255, 255, 0.6); }
.sw.sel { border-width: 2px; border-color: #ffffff; }
.sw-pick {
    width: 40px;
    height: 31px;
    margin: 0 6px 6px 0;
    padding: 0;
    border-width: 1px;
    border-color: var(--line-2);
    background-color: rgba(0, 0, 0, 0.3);
    color: var(--text-dim);
    font-size: 18px;
    -unity-text-align: middle-center;
}
.sw-pick:hover { border-color: var(--cyan); color: var(--text); }
.sw-pick.sel { border-width: 2px; border-color: #ffffff; color: #ffffff; }

.picker { margin-top: 10px; padding: 11px; border-width: 1px; border-color: var(--line); background-color: rgba(0, 0, 0, 0.3); }
.picker-top { flex-direction: row; }
.picker-sv { width: 180px; height: 120px; border-width: 1px; border-color: var(--line-2); }
.picker-knob { position: absolute; width: 12px; height: 12px; margin-left: -6px; margin-top: -6px; border-radius: 6px; border-width: 2px; border-color: #ffffff; }
.picker-side { margin-left: 14px; }
.picker-preview { width: 54px; height: 54px; border-width: 1px; border-color: var(--line-2); }
.picker-hex { margin-top: 8px; font-size: 14px; color: var(--text-dim); }
.picker-hue { height: 14px; margin-top: 11px; border-width: 1px; border-color: var(--line-2); }
.picker-hue-knob { position: absolute; top: -3px; bottom: -3px; width: 4px; margin-left: -2px; background-color: #ffffff; }
.picker-row { margin-top: 8px; }
.picker-row > .dz-lab { margin-bottom: 4px; }

/* ---------------------------------------------------------------- Main menu */
.main-menu { flex-direction: row; }
.menu-vignette {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 62%;
    background-image: url("../Textures/grad_h.png");
    -unity-background-image-tint-color: rgba(3, 5, 8, 0.88);
}
.menu-col { width: 42%; max-width: 560px; padding: 76px 0 64px 115px; flex-direction: column; }
.title-block > .kicker { margin-bottom: 20px; }
.title { font-size: 76px; letter-spacing: 6px; color: #eef4f8; text-shadow: 0 0 30px rgba(95, 212, 240, 0.25); }
.title-sub { font-size: 42px; letter-spacing: 21px; color: var(--cyan); margin-top: 6px; white-space: nowrap; }
.title-logo { width: 620px; -unity-background-scale-mode: scale-to-fit; }
.title-rule { width: 162px; height: 2px; margin: 29px 0 43px 0; background-image: url("../Textures/rule.png"); }
.menu-list { flex-direction: column; flex-grow: 1; }
.menu-list > .btn { margin-bottom: 4px; }
.menu-foot { font-size: 13.5px; letter-spacing: 0.7px; color: var(--text-faint); }

/* ---------------------------------------------------------------- Character select & designer */
.char-select { flex-direction: row; }
.cs-vignette {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 55%;
    background-image: url("../Textures/grad_h_r.png");
    -unity-background-image-tint-color: rgba(3, 5, 8, 0.92);
}
.cs-drag { flex-grow: 1; }
.cs-info { width: 36%; max-width: 480px; flex-shrink: 0; flex-direction: column; padding: 76px 77px 64px 0; }
.cs-info > * { margin-bottom: 14px; }
.cs-tabs { flex-direction: row; flex-shrink: 0; }
.cs-tab {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
    align-items: flex-start;
    margin: 0 9px 0 0;
    padding: 16px;
    background-color: var(--bg-2);
    border-width: 1px;
    border-color: var(--line);
    color: var(--text-dim);
}
.cs-tab:hover, .cs-tab.focus { border-color: var(--line-2); color: var(--text); }
.cs-tab.sel { border-color: var(--cyan); color: var(--text); background-color: rgba(95, 212, 240, 0.1); }
.cs-tab.lyra.sel { border-color: var(--violet); background-color: rgba(166, 139, 255, 0.1); }
.cs-tab.sel.focus { border-color: #9fe6f7; }
.cs-tab.lyra.sel.focus { border-color: #cdbdff; }
.cs-tab-n { font-size: 20px; letter-spacing: 2.4px; }
.cs-tab-r { font-size: 13.5px; margin-top: 7px; }
.cs-name { font-size: 54px; letter-spacing: 3.2px; margin-top: 7px; }
.cs-role { color: var(--cyan); font-size: 15px; letter-spacing: 4.6px; }
.cs-role.lyra { color: var(--violet); }
.cs-desc { color: var(--text-dim); font-size: 16.5px; }
.cs-meta { flex-direction: row; font-size: 14px; color: var(--text-dim); }
.cs-meta-i { margin-right: 22px; flex-shrink: 1; }
.cs-abilities { flex-direction: column; }
.cs-ab { flex-direction: row; align-items: center; margin-bottom: 9px; padding: 11px; border-width: 1px; border-color: var(--line); background-color: rgba(0, 0, 0, 0.25); }
.cs-ab-icon { width: 43px; height: 43px; margin-right: 14px; }
.cs-ab-text { flex-grow: 1; flex-shrink: 1; }
.cs-ab-t { font-size: 16px; letter-spacing: 1.6px; }
.cs-ab-d { font-size: 14px; color: var(--text-dim); margin-top: 4px; }
.cs-info > .section-title { margin: 7px 0 0 0; }
.cs-slots > .seg-btn { white-space: normal; min-width: 90px; }
.cs-hint { font-size: 13.5px; color: var(--text-faint); }
.cs-actions { flex-direction: row; flex-shrink: 0; }
.cs-actions > .btn-small { margin-right: 11px; }

.cs-info.designer {
    width: 40%;
    max-width: 540px;
    padding: 64px 36px 36px 29px;
    background-color: rgba(5, 8, 12, 0.9);
    border-left-width: 1px;
    border-color: var(--line);
}
.cs-info.designer > * { margin-bottom: 11px; }
.dz-tabs { padding: 0; }
.dz-tabs > .tab { padding: 14px 15px; }
.dz-body { flex-grow: 1; flex-shrink: 1; }
.dz-body > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container > .btn { margin-bottom: 4px; }
.dz-row { padding: 8px 4px; border-bottom-width: 1px; border-color: rgba(255, 255, 255, 0.04); }
.dz-row.inline { flex-direction: row; justify-content: space-between; align-items: center; }
.dz-row:hover { background-color: rgba(95, 212, 240, 0.05); }
.dz-lab { font-size: 13px; letter-spacing: 3.6px; color: var(--text-dim); margin-bottom: 9px; }
.dz-row.inline > .dz-lab { margin-bottom: 0; }
.dz-note { margin-top: 18px; }
.hairgrid { flex-direction: row; flex-wrap: wrap; }
.chip { width: 31%; margin: 0 2% 7px 0; padding: 8px 4px; }

/* ---------------------------------------------------------------- Loading */
.loading { background-color: #05070a; overflow: hidden; }
.loading-artback, .loading-art, .loading-vignette, .loading-shade { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.loading-art { -unity-background-scale-mode: scale-and-crop; opacity: 0.55; }
.loading-vignette { background-image: url("../Textures/vignette.png"); -unity-background-image-tint-color: rgba(4, 6, 10, 0.95); }
.loading-shade { background-image: url("../Textures/shade_v.png"); -unity-background-image-tint-color: rgba(3, 5, 8, 0.96); }
.loading-content { position: absolute; left: 6%; right: 6%; bottom: 8%; flex-direction: row; align-items: flex-end; }
.loading-left { flex-grow: 1; flex-shrink: 1; margin-right: 77px; }
.loading-right { width: 468px; flex-shrink: 0; }
.zone-name { font-size: 61px; letter-spacing: 3.7px; }
.zone-sub { margin-top: 9px; font-size: 16px; letter-spacing: 5.8px; color: var(--cyan); }
.quote { margin-top: 29px; max-width: 720px; color: var(--text-dim); }
.loading-hint {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 25px;
    padding-left: 18px;
    border-left-width: 2px;
    border-color: var(--violet);
    font-size: 15.5px;
    color: var(--text-dim);
}
.loading-bar { height: 3px; background-color: rgba(255, 255, 255, 0.08); overflow: hidden; }
.loading-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background-image: url("../Textures/grad_cv.png");
    transition-property: width;
    transition-duration: 0.15s;
    transition-timing-function: linear;
}
.loading-stage { flex-direction: row; justify-content: space-between; margin-top: 13px; }
.loading-stage-l, .loading-stage-r { font-size: 13.5px; letter-spacing: 3.6px; color: var(--text-faint); }
.loading-err { margin-top: 18px; color: var(--red); }

/* ---------------------------------------------------------------- HUD */
.hud { transition-property: opacity; transition-duration: 0.3s; }
.hud.fade { opacity: 0; }

.vitals { position: absolute; left: 2.2%; bottom: 3.2%; width: 432px; flex-direction: row; align-items: flex-end; }
.portrait {
    width: 79px;
    height: 79px;
    margin-right: 16px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: var(--line-2);
    background-color: #0a0e13;
    -unity-background-scale-mode: scale-and-crop;
}
.portrait.kael { border-color: rgba(95, 184, 255, 0.6); }
.portrait.lyra { border-color: rgba(166, 139, 255, 0.6); }
.portrait-initial { font-size: 40px; }
.portrait-swap { position: absolute; right: -11px; top: -11px; }
.vit-bars { flex-grow: 1; flex-shrink: 1; }
.vit-name { font-size: 17px; letter-spacing: 3.4px; margin-bottom: 8px; }
.bar { height: 10px; margin-top: 5px; overflow: hidden; background-color: rgba(255, 255, 255, 0.07); }
.bar-fill, .bar-trail { position: absolute; left: 0; top: 0; bottom: 0; }
.bar-fill { transition-property: width; transition-duration: 0.12s; transition-timing-function: linear; }
.bar-trail { background-color: rgba(255, 90, 74, 0.7); }
.bar.hp > .bar-fill { background-color: #e8eef3; }
.bar.sh { height: 7px; }
.bar.sh > .bar-fill { background-color: var(--cyan); }
.bar.en { height: 5px; }
.bar.en > .bar-fill { background-color: var(--violet); }
.vit-num { flex-direction: row; justify-content: space-between; margin-top: 6px; }
.vit-num-l, .vit-num-r { font-size: 12.6px; letter-spacing: 1px; color: var(--text-dim); }

.abilities { position: absolute; right: 2.2%; bottom: 3.2%; flex-direction: row; align-items: flex-end; }
.ab { width: 65px; margin-left: 11px; align-items: center; }
.slot {
    width: 65px;
    height: 65px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-width: 1px;
    border-color: var(--line-2);
    background-color: rgba(6, 9, 13, 0.7);
}
.slot-icon { width: 40px; height: 40px; }
.slot-cd, .slot-cdt { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.slot-cdt { font-size: 18px; -unity-text-align: middle-center; }
.slot-lock { position: absolute; left: 14px; top: 14px; width: 35px; height: 35px; }
.ab.locked > .slot { opacity: 0.35; }
.ab.ready > .slot { border-color: var(--cyan); }
.charges { position: absolute; top: 4px; right: 5px; font-size: 12.6px; }
.ab-kc { flex-direction: row; justify-content: center; margin-top: 6px; }
.ab-lbl { margin-top: 5px; font-size: 10.4px; letter-spacing: 1.2px; color: var(--text-faint); white-space: nowrap; }
.ult-wrap { width: 83px; }
.ult { width: 83px; height: 83px; align-items: center; justify-content: center; }
.ult-ring { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.ult-icon { width: 41px; height: 41px; }
.ult-wrap.locked > .ult { opacity: 0.45; }
.ult.full { scale: 1.06 1.06; }

.tracker { position: absolute; left: 2.2%; top: 3%; width: 396px; }
.tracker-q { flex-direction: row; align-items: center; padding: 2px 0; }
.tag { margin-right: 11px; padding: 4px 8px; border-width: 1px; border-color: var(--cyan-dim); font-size: 12px; letter-spacing: 2.4px; color: var(--cyan); }
.tag.side { border-color: var(--violet-dim); color: var(--violet); }
.tracker-title { font-size: 17px; letter-spacing: 2.4px; flex-shrink: 1; text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8); }
.tracker-obj { flex-direction: row; margin-top: 10px; }
.dot { width: 11px; height: 11px; margin: 6px 11px 0 2px; flex-shrink: 0; border-width: 1px; border-color: var(--cyan); rotate: 45deg; }
.tracker-obj.done > .dot { background-color: var(--cyan); }
.tracker-obj-t { font-size: 15.5px; flex-shrink: 1; text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8); }
.tracker-obj.done > .tracker-obj-t { color: var(--text-faint); }

.minimap { position: absolute; right: 2.2%; top: 3%; width: 207px; align-items: center; }
.minimap-disc {
    width: 207px;
    height: 207px;
    overflow: hidden;
    border-width: 1px;
    border-color: var(--line-2);
    border-radius: 104px;
    background-color: rgba(5, 8, 12, 0.7);
}
.mapview { flex-grow: 1; }
.minimap-disc > .mapview { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.minimap-zone { margin-top: 9px; font-size: 13px; letter-spacing: 3.1px; color: var(--text-dim); }
.map-label { position: absolute; translate: -50% -50%; font-size: 12px; letter-spacing: 0.6px; color: rgba(200, 220, 235, 0.7); white-space: nowrap; }
.map-label.small { font-size: 9px; }
.map-north { position: absolute; translate: -50% -50%; font-size: 14px; color: var(--cyan); }

.powerups { position: absolute; left: 2.2%; bottom: 12.5%; flex-direction: row; }
.pu {
    width: 47px;
    height: 47px;
    margin-right: 9px;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: var(--line-2);
    background-color: rgba(6, 9, 13, 0.75);
}
.pu > .icon { width: 29px; height: 29px; }
.pu-ring { position: absolute; left: 0; bottom: 0; height: 2px; }
.pu-t { position: absolute; left: 0; right: 0; bottom: -18px; font-size: 11px; color: var(--text-dim); -unity-text-align: middle-center; }

.prompt {
    position: absolute;
    left: 50%;
    bottom: 22%;
    translate: -50% 0;
    flex-direction: row;
    align-items: center;
    padding: 10px 18px;
    border-width: 1px;
    border-color: var(--line-2);
    background-color: rgba(6, 9, 13, 0.78);
}
.prompt-text { margin-left: 10px; font-size: 17px; letter-spacing: 2px; white-space: nowrap; }

.crosshair { position: absolute; left: 50%; top: 50%; width: 25px; height: 25px; translate: -50% -50%; opacity: 0; transition-property: opacity; transition-duration: 0.15s; }
.crosshair.on { opacity: 1; }
.cross-v { position: absolute; left: 12px; top: 0; bottom: 0; width: 1px; background-color: rgba(230, 245, 255, 0.9); }
.cross-h { position: absolute; top: 12px; left: 0; right: 0; height: 1px; background-color: rgba(230, 245, 255, 0.9); }
.hitmark {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 29px;
    height: 29px;
    translate: -50% -50%;
    rotate: 45deg;
    border-width: 2px;
    border-radius: 2px;
    border-color: rgba(255, 255, 255, 0.9);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.18s;
}
.hitmark.on { opacity: 0.85; transition-duration: 0s; }
.hitmark.kill { border-color: var(--red); }

.marker { position: absolute; translate: -50% -100%; align-items: center; }
.marker-m { width: 18px; height: 18px; rotate: 45deg; border-width: 2px; border-color: var(--amber); background-color: rgba(255, 180, 94, 0.25); }
.marker-d { margin-top: 9px; font-size: 12.6px; letter-spacing: 1.3px; color: var(--amber); text-shadow: 0 1px 3px #000000; }
.marker.edge > .marker-m { background-color: rgba(255, 180, 94, 0.45); }

.ebar { position: absolute; width: 90px; translate: -50% -100%; }
.ebar-n { margin-bottom: 4px; font-size: 11px; letter-spacing: 1.5px; color: #ffd2cc; -unity-text-align: middle-center; white-space: nowrap; text-shadow: 0 1px 2px #000000; }
.ebar-b { height: 6px; border-width: 1px; border-color: rgba(255, 255, 255, 0.15); background-color: rgba(0, 0, 0, 0.6); }
.ebar-fill { height: 100%; background-color: var(--red); }
.ebar-p { height: 2px; margin-top: 1px; background-color: rgba(0, 0, 0, 0.5); }
.ebar-pfill { height: 100%; background-color: var(--amber); }
.ebar.stag .ebar-fill { background-color: var(--amber); }

.bossbar { position: absolute; left: 50%; top: 4%; width: 828px; max-width: 70%; translate: -50% 0; }
.bossbar-n { margin-bottom: 9px; font-size: 18px; letter-spacing: 7px; color: #ffd6d0; -unity-text-align: middle-center; }
.bossbar-b { height: 11px; border-width: 1px; border-color: rgba(255, 120, 110, 0.35); background-color: rgba(0, 0, 0, 0.6); }
.bossbar-fill { position: absolute; left: 0; top: 0; bottom: 0; background-image: url("../Textures/grad_boss.png"); transition-property: width; transition-duration: 0.15s; }
.bossbar-ph { margin-top: 7px; font-size: 12.6px; letter-spacing: 3.8px; color: var(--text-dim); -unity-text-align: middle-center; }

/* ---------------------------------------------------------------- Feedback */
.toasts { position: absolute; right: 2.2%; top: 34%; flex-direction: column; align-items: flex-end; }
.toast {
    max-width: 468px;
    margin-bottom: 7px;
    padding: 10px 16px;
    border-left-width: 2px;
    border-color: var(--cyan);
    background-color: rgba(6, 9, 13, 0.82);
    font-size: 15px;
}
.toast.k-quest { border-color: var(--amber); letter-spacing: 1.2px; font-size: 16.5px; }
.toast.k-item { border-color: var(--green); }
.toast.k-lore { border-color: var(--violet); }
.toast.k-warn { border-color: var(--red); }

.hintbox {
    position: absolute;
    top: 13%;
    left: 50%;
    max-width: 612px;
    translate: -50% 0;
    padding: 14px 22px;
    border-width: 1px;
    border-top-width: 2px;
    border-color: var(--line-2);
    border-top-color: var(--violet);
    background-color: rgba(6, 9, 13, 0.85);
    font-size: 16px;
}

.questbanner { position: absolute; top: 28%; left: 0; right: 0; align-items: center; }
.qb-k { font-size: 14.4px; letter-spacing: 7px; color: var(--amber); }
.qb-t { margin-top: 5px; font-size: 40px; letter-spacing: 4px; }

.saveind {
    position: absolute;
    right: 2.2%;
    bottom: 245px;
    flex-direction: row;
    align-items: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.4s;
    font-size: 13.5px;
    letter-spacing: 2.7px;
    color: var(--text-dim);
}
.saveind.on { opacity: 1; }
.saveind-spin {
    width: 16px;
    height: 16px;
    margin-right: 11px;
    border-width: 2px;
    border-radius: 8px;
    border-color: var(--cyan);
    border-right-color: rgba(0, 0, 0, 0);
}

.letterbox {
    position: absolute;
    left: 0;
    right: 0;
    height: 0;
    background-color: #000000;
    transition-property: height;
    transition-duration: 0.6s;
    transition-timing-function: ease;
}
.letterbox.top { top: 0; }
.letterbox.bot { bottom: 0; }
.letterbox.on { height: 113px; }

.skip {
    position: absolute;
    right: 3%;
    bottom: 3%;
    flex-direction: row;
    align-items: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.3s;
    font-size: 13.5px;
    letter-spacing: 2.7px;
    color: var(--text-dim);
}
.skip.on { opacity: 1; }
.skip-ring { width: 25px; height: 25px; margin-right: 11px; }
.skip-text { margin-right: 11px; }

.fader { background-color: #000000; }

.debug {
    position: absolute;
    left: 11px;
    top: 30%;
    padding: 13px 16px;
    border-width: 1px;
    border-color: rgba(95, 212, 240, 0.3);
    background-color: rgba(0, 0, 0, 0.78);
}
.debug-row { flex-direction: row; }
.debug-k { width: 96px; font-size: 13px; color: #6fd0a0; }
.debug-v { font-size: 13px; color: #b8ffd8; white-space: nowrap; }

/* ---------------------------------------------------------------- Dialogue & subtitles */
.dialogue { position: absolute; left: 50%; bottom: 5%; width: 1044px; max-width: 90%; translate: -50% 0; flex-direction: row; padding: 22px 25px; }
.dlg-pt {
    width: 117px;
    height: 117px;
    margin-right: 22px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: var(--line-2);
    background-color: #0a0e13;
    -unity-background-scale-mode: scale-and-crop;
}
.dlg-pt-initial { font-size: 54px; }
.dlg-body { flex-grow: 1; flex-shrink: 1; padding-bottom: 14px; }
.dlg-nm { margin-bottom: 11px; font-size: 18px; letter-spacing: 4.3px; }
.dlg-tx { min-height: 54px; font-size: 21px; }
.dlg-ch { margin-top: 16px; }
.dlg-choice { margin-bottom: 5px; padding: 10px 16px; font-size: 17px; letter-spacing: 0.8px; }
.dlg-choice:hover, .dlg-choice.focus { padding-left: 21px; }
.dlg-cont { position: absolute; right: 22px; bottom: 16px; flex-direction: row; align-items: center; }
.dlg-cont-t { margin-right: 9px; font-size: 12.6px; letter-spacing: 3.6px; color: var(--text-faint); }
.subs { position: absolute; left: 50%; bottom: 14.5%; width: 936px; max-width: 84%; translate: -50% 0; align-items: center; }
.subs-line { flex-direction: row; flex-wrap: wrap; justify-content: center; align-items: center; padding: 8px 16px; background-color: rgba(0, 0, 0, 0.55); }
.subs-who { margin-right: 11px; font-size: 17px; letter-spacing: 3.6px; }
.subs-text { flex-shrink: 1; font-size: 21px; -unity-text-align: middle-center; text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9); }

/* ---------------------------------------------------------------- Modals, tabs, rows */
.modal { width: 94%; max-width: 1152px; max-height: 88%; flex-direction: column; }
.modal-head { flex-direction: row; align-items: center; flex-shrink: 0; padding: 22px 29px; border-bottom-width: 1px; border-color: var(--line); }
.modal-head > .btn-small { margin-left: 11px; }
.modal-title { flex-grow: 1; flex-shrink: 1; }
.tabs { flex-direction: row; flex-shrink: 0; padding: 0 29px; border-bottom-width: 1px; border-color: var(--line); }
.tab {
    margin: 0 4px 0 0;
    padding: 16px 20px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0 0 2px 0;
    border-color: rgba(0, 0, 0, 0);
    color: var(--text-dim);
    font-size: 15px;
    letter-spacing: 3px;
    white-space: nowrap;
    -unity-text-align: middle-center;
}
.tab:hover, .tab.focus { color: var(--text); }
.tab.focus { background-color: rgba(95, 212, 240, 0.06); }
.tab.sel { color: var(--text); border-color: var(--cyan); }
.modal-body { flex-grow: 1; flex-shrink: 1; padding: 22px 29px; }
.modal-foot { flex-direction: row; align-items: center; flex-shrink: 0; padding: 16px 29px; border-top-width: 1px; border-color: var(--line); }
.foot-note { font-size: 13.5px; color: var(--text-faint); }
.hintline { flex-direction: row; }
.hint-item { flex-direction: row; align-items: center; margin-right: 18px; }
.hint-t { margin-left: 4px; font-size: 13.5px; color: var(--text-faint); }

.row { flex-direction: row; align-items: center; padding: 11px 14px; border-bottom-width: 1px; border-color: rgba(255, 255, 255, 0.04); }
.row:hover { background-color: rgba(95, 212, 240, 0.06); }
.row-lab { flex-grow: 1; flex-shrink: 1; margin-right: 18px; }
.row-l { font-size: 16.5px; }
.row-d { margin-top: 4px; font-size: 12.5px; color: var(--text-faint); }
.row-ctl { width: 396px; flex-shrink: 0; flex-direction: row; justify-content: flex-end; align-items: center; }

.bind { flex-direction: row; justify-content: flex-end; }
.bind-btn {
    min-width: 132px;
    margin: 0 0 0 7px;
    padding: 8px 11px;
    border-width: 1px;
    border-color: var(--line);
    background-color: rgba(0, 0, 0, 0.35);
    color: var(--text);
    font-size: 13.5px;
    letter-spacing: 1.4px;
    -unity-text-align: middle-center;
    white-space: nowrap;
}
.bind-btn:hover, .bind-btn.focus { border-color: var(--cyan); }
.bind-btn.listen { border-color: var(--amber); color: var(--amber); }
.bind-btn:disabled { opacity: 0.5; }
.bind-head { flex-direction: row; align-items: center; padding: 0 14px 4px 14px; }
.bind-head > .row-l { flex-grow: 1; }
.bind-col { min-width: 132px; margin-left: 7px; font-size: 11px; letter-spacing: 2px; color: var(--text-faint); -unity-text-align: middle-center; }

.stat-grid { flex-direction: row; flex-wrap: wrap; }
.stat { width: 31.3%; margin: 0 2% 11px 0; padding: 14px; border-width: 1px; border-color: var(--line); background-color: rgba(0, 0, 0, 0.3); }
.stat-v { font-size: 27px; }
.stat-l { margin-top: 7px; font-size: 11.7px; letter-spacing: 2.3px; color: var(--text-dim); }

/* ---------------------------------------------------------------- Pause */
.pause { flex-direction: row; }
.pause-side {
    width: 40%;
    max-width: 432px;
    flex-shrink: 0;
    padding: 86px 48px;
    border-right-width: 1px;
    border-color: var(--line);
    background-color: rgba(3, 5, 8, 0.88);
}
.pause-side > .btn { margin-bottom: 4px; }
.pause-title { margin: 11px 0 22px 0; }
.pause-summary { flex-grow: 1; flex-shrink: 1; max-width: 860px; padding: 86px 77px; }
.pause-summary > * { margin-bottom: 22px; }
.pause-text { font-size: 17px; color: var(--text-dim); }

/* ---------------------------------------------------------------- Saves */
.slots { flex-direction: column; }
.slot-card { flex-direction: row; align-items: center; margin-bottom: 14px; padding: 16px; border-width: 1px; border-color: var(--line); background-color: rgba(0, 0, 0, 0.3); }
.slot-card:hover { border-color: var(--cyan); }
.slot-thumb {
    width: 216px;
    height: 122px;
    margin-right: 22px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: var(--line);
    background-color: #0a0e13;
    -unity-background-scale-mode: scale-and-crop;
}
.slot-thumb-t { font-size: 13.5px; letter-spacing: 2.7px; color: var(--text-faint); }
.slot-info { flex-grow: 1; flex-shrink: 1; }
.slot-t { font-size: 20px; letter-spacing: 2.4px; }
.slot-m { margin-top: 9px; font-size: 14.4px; color: var(--text-dim); }
.slot-st { margin-top: 7px; font-size: 12.6px; letter-spacing: 2.5px; }
.slot-st.bad { color: var(--red); }
.slot-st.rec { color: var(--amber); }
.slot-acts { flex-direction: column; flex-shrink: 0; margin-left: 22px; }
.slot-acts > .btn-small { margin-bottom: 7px; }

/* ---------------------------------------------------------------- Death */
.death { align-items: center; justify-content: center; background-color: rgba(40, 6, 6, 0.55); }
.death-vignette { background-image: url("../Textures/vignette.png"); -unity-background-image-tint-color: rgba(0, 0, 0, 0.92); }
.death-box { align-items: center; }
.death-t { font-size: 72px; letter-spacing: 21px; color: #ff8070; }
.death-s { margin: 18px 0 36px 0; color: var(--text-dim); }
.death-acts { width: 360px; flex-direction: column; }
.death-acts > .btn { margin-bottom: 5px; }

/* ---------------------------------------------------------------- Credits */
.credits { overflow: hidden; background-color: #000000; }
.credits-roll { position: absolute; left: 0; right: 0; top: 100%; align-items: center; padding: 0 5%; }
.credits-h1 { margin-bottom: 20px; font-size: 65px; letter-spacing: 7.8px; -unity-text-align: middle-center; }
.credits-h2 { margin: 54px 0 18px 0; font-size: 14.4px; letter-spacing: 5.8px; color: var(--cyan); -unity-text-align: middle-center; }
.credits-p { max-width: 720px; margin: 6px 0; color: var(--text-dim); -unity-text-align: middle-center; }
.credits-quote { margin-top: 108px; color: var(--text-dim); -unity-text-align: middle-center; }
.credits-skip { position: absolute; right: 3%; bottom: 3%; font-size: 13.5px; letter-spacing: 2.7px; color: var(--text-faint); }

/* ---------------------------------------------------------------- Confirm */
.confirm { width: 90%; max-width: 540px; padding: 29px; }
.confirm-t { font-size: 22px; letter-spacing: 2.2px; }
.confirm-m { margin: 14px 0 25px 0; color: var(--text-dim); }
.confirm-acts { flex-direction: row; justify-content: flex-end; }
.confirm-acts > .btn-small { margin-left: 11px; }

/* ---------------------------------------------------------------- Inventory */
.inv { flex-direction: row; min-height: 468px; }
.inv-grid { flex-grow: 1; flex-shrink: 1; flex-direction: row; flex-wrap: wrap; align-content: flex-start; margin-right: 22px; }
.item {
    width: 100px;
    height: 100px;
    margin: 0 9px 9px 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: var(--line);
    background-color: rgba(0, 0, 0, 0.35);
}
.item-icon { width: 47px; height: 47px; }
.item-art { -unity-background-scale-mode: scale-to-fit; border-bottom-width: 2px; }
.item-q { position: absolute; right: 6px; bottom: 4px; font-size: 14px; }
.item.sel, .item.focus, .item:hover { border-color: var(--cyan); background-color: rgba(95, 212, 240, 0.1); }
.item.r-uncommon { border-bottom-width: 2px; border-bottom-color: #5fd4f0; }
.item.r-rare { border-bottom-width: 2px; border-bottom-color: #a68bff; }
.item.r-epic { border-bottom-width: 2px; border-bottom-color: #ffb45e; }
.detail { width: 360px; flex-shrink: 0; padding: 18px; border-width: 1px; border-color: var(--line); background-color: rgba(0, 0, 0, 0.3); }
.detail > * { margin-bottom: 12px; }
.detail-icon { width: 61px; height: 61px; }
.detail-nm { font-size: 22px; letter-spacing: 2.2px; }
.detail-rar { font-size: 12.6px; letter-spacing: 3px; }
.detail-ds { font-size: 15.8px; color: var(--text-dim); }
.detail-q { font-size: 14.4px; }
.detail-use { align-self: flex-start; }
.lore-list { flex-direction: column; }
.lore-entry { margin-bottom: 11px; padding: 14px; border-left-width: 2px; border-color: var(--violet); background-color: rgba(0, 0, 0, 0.25); }
.lore-h { margin-bottom: 9px; font-size: 15.3px; letter-spacing: 2.1px; }
.lore-l { margin-bottom: 4px; font-size: 15.3px; color: var(--text-dim); }

/* ---------------------------------------------------------------- Map */
.map-wrap { flex-direction: row; }
.map-frame { flex-grow: 1; height: 560px; margin-right: 18px; border-width: 1px; border-color: var(--line); background-color: #060a0e; }
.map-canvas { flex-grow: 1; }
.legend { width: 288px; flex-shrink: 0; }
.legend > * { margin-bottom: 9px; }
.legend > .section-title { margin: 18px 0 4px 0; }
.legend-title { font-size: 22px; }
.legend-row { flex-direction: row; align-items: center; }
.legend-sw { width: 14px; height: 14px; margin-right: 9px; flex-shrink: 0; }
.legend-t { flex-shrink: 1; font-size: 14.4px; color: var(--text-dim); }

/* ---------------------------------------------------------------- Journal */
.completion { flex-direction: row; margin-bottom: 18px; }
.completion > .stat { width: 32%; margin: 0 1.3% 0 0; }
.journal { flex-direction: row; min-height: 468px; }
.qlist { width: 324px; flex-shrink: 0; margin-right: 18px; }
.qbtn { margin-bottom: 4px; padding: 11px 14px; font-size: 15.3px; letter-spacing: 1.5px; }
.qbtn.current {
    color: var(--text);
    border-left-color: var(--cyan);
    background-image: url("../Textures/grad_h.png");
    -unity-background-image-tint-color: rgba(95, 212, 240, 0.14);
}
.qd { flex-grow: 1; flex-shrink: 1; }
.qd-t { margin-top: 8px; font-size: 29px; letter-spacing: 1.7px; }
.qd-s { margin: 14px 0 22px 0; color: var(--text-dim); }
.qd-o { flex-direction: row; padding: 7px 0; }
.qd-o > .dot { border-color: var(--amber); }
.qd-o.done > .dot { background-color: var(--amber); }
.qd-o-t { flex-shrink: 1; font-size: 16px; }
.qd-o.done > .qd-o-t { color: var(--text-faint); }
.qd-track { align-self: flex-start; margin-top: 18px; }

/* ---------------------------------------------------------------- Ability Matrix */
.skills-head { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 18px; }
.skills-desc { flex-shrink: 1; max-width: 720px; font-size: 15.3px; }
.skills-points { flex-direction: row; align-items: center; flex-shrink: 0; margin-left: 18px; }
.skills-points-l { margin-right: 11px; font-size: 14.4px; letter-spacing: 2px; }
.points { font-size: 20px; color: var(--cyan); }
.tree { flex-direction: row; }
.tree-col { flex-grow: 1; flex-basis: 0; margin-right: 22px; }
.tree-h { margin-bottom: 11px; font-size: 15.3px; letter-spacing: 3.7px; }
.tree-ab { margin: 11px 0 7px 0; font-size: 13.5px; letter-spacing: 2.7px; }
.tree-row { flex-direction: row; margin-bottom: 14px; }
.node {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 115px;
    margin: 0 9px 0 0;
    padding: 14px;
    flex-direction: column;
    align-items: stretch;
    border-width: 1px;
    border-color: var(--line);
    background-color: rgba(0, 0, 0, 0.3);
    color: var(--text);
}
.node-n { margin-right: 22px; font-size: 15.3px; letter-spacing: 1.2px; }
.node-d { margin-top: 7px; font-size: 13px; color: var(--text-dim); }
.node-c { position: absolute; right: 11px; top: 11px; font-size: 13.5px; color: var(--cyan); }
.node.owned { border-color: var(--cyan); background-color: rgba(95, 212, 240, 0.12); }
.node.owned > .node-c { color: var(--green); }
.node.avail:hover, .node.focus { border-color: var(--violet); }
.node.locked { opacity: 0.45; }
.node.locked.focus { opacity: 0.7; }

/* Customization thumbnail grids (hair styles, glasses, armour sets, tattoos) */
.imggrid { flex-direction: row; flex-wrap: wrap; margin-top: 4px; }
.imgchip { width: 31%; margin: 0 2% 8px 0; padding: 4px; background-color: var(--bg-3); border-width: 1px; border-color: var(--line); border-radius: 3px; }
.imgchip.sel { border-color: var(--cyan); background-color: rgba(0, 229, 255, 0.12); }
.imgchip.focus { border-color: var(--violet); }
.imgchip-img { height: 78px; -unity-background-scale-mode: scale-and-crop; background-color: rgba(0, 0, 0, 0.35); align-items: center; justify-content: center; }
.imgchip-ph { font-size: 26px; color: var(--text-faint); }
.imgchip-l { font-size: 12px; color: var(--text); -unity-text-align: middle-center; margin-top: 4px; white-space: normal; }

/* ---------------------------------------------------------------- Driving HUD (DriveHud: speed dial in place of the ability bar) */
.drive { position: absolute; right: 2.2%; bottom: 3.2%; align-items: center; }
.drive-dial { width: 214px; height: 214px; align-items: center; justify-content: center; }
.drive-arc { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.drive-center { align-items: center; margin-top: -6px; }
.drive-speed {
    font-size: 66px;
    color: var(--text);
    -unity-text-align: middle-center;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8);
    -unity-font: url("../Fonts/Rajdhani/Rajdhani-Bold.ttf");
    -unity-font-definition: url("../Fonts/Rajdhani/Rajdhani-Bold_SDF.asset");
}
.drive-unit {
    margin-top: -10px;
    font-size: 13px;
    letter-spacing: 3.2px;
    color: var(--text-dim);
    -unity-font: url("../Fonts/Rajdhani/Rajdhani-SemiBold.ttf");
    -unity-font-definition: url("../Fonts/Rajdhani/Rajdhani-SemiBold_SDF.asset");
}
.drive-gear {
    position: absolute;
    bottom: 20px;
    font-size: 24px;
    color: var(--cyan);
    -unity-text-align: middle-center;
    -unity-font: url("../Fonts/Rajdhani/Rajdhani-Bold.ttf");
    -unity-font-definition: url("../Fonts/Rajdhani/Rajdhani-Bold_SDF.asset");
}
.drive-keys { flex-direction: row; margin-top: 8px; }
.drive-key { flex-direction: row; align-items: center; margin: 0 7px; }
.drive-key-l {
    margin-left: 5px;
    font-size: 11px;
    letter-spacing: 1.4px;
    color: var(--text-faint);
    white-space: nowrap;
    -unity-font: url("../Fonts/Rajdhani/Rajdhani-Medium.ttf");
    -unity-font-definition: url("../Fonts/Rajdhani/Rajdhani-Medium_SDF.asset");
}
